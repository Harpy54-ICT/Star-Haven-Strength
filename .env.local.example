# =============================================================================
# Star Haven Strength — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is gitignored). This file documents every key.
# Each section notes WHERE to obtain the value.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Vercel Postgres
# -----------------------------------------------------------------------------
# Vercel Dashboard → Storage → your Postgres store → ".env.local" tab.
# Copy all three connection strings exactly as Vercel provides them.
# POSTGRES_PRISMA_URL is the pooled connection (used by Prisma at runtime).
# POSTGRES_URL_NON_POOLING is the direct connection (used for migrations).
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# -----------------------------------------------------------------------------
# AUTH — Auth.js v5 (next-auth@beta)
# -----------------------------------------------------------------------------
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`.
# AUTH_URL: the canonical URL of the app (e.g. https://www.starhavenstrength.com).
#   For local dev use http://localhost:3000.
AUTH_SECRET=
AUTH_URL=

# -----------------------------------------------------------------------------
# GOOGLE — OAuth sign-in + Calendar/Meet (service account)
# -----------------------------------------------------------------------------
# OAuth credentials: Google Cloud Console → APIs & Services → Credentials →
#   "OAuth 2.0 Client IDs". Authorized redirect URI:
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Service account (for creating Google Calendar events / Meet links server-side):
#   Google Cloud Console → IAM & Admin → Service Accounts → create key (JSON).
#   GOOGLE_SERVICE_ACCOUNT_EMAIL is the service account's email.
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the "private_key" field from the JSON
#   (keep the literal \n escapes, wrap the whole value in double quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The calendar ID the admin uses for coaching bookings (usually the admin's
# primary calendar email, or a dedicated shared calendar ID).
GOOGLE_ADMIN_CALENDAR_ID=

# -----------------------------------------------------------------------------
# VERCEL BLOB — file storage (progress photos, verification docs)
# -----------------------------------------------------------------------------
# Vercel Dashboard → Storage → Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# STRIPE — payments
# -----------------------------------------------------------------------------
# Keys: Stripe Dashboard → Developers → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret: Stripe Dashboard → Developers → Webhooks → your
# endpoint → "Signing secret".
STRIPE_WEBHOOK_SECRET=
# Price IDs: Stripe Dashboard → Products. Create one price per tier/period.
# CIVILIAN tiers:
STRIPE_FOUNDATION_CIVILIAN_MONTHLY_PRICE_ID=
STRIPE_FOUNDATION_CIVILIAN_ANNUAL_PRICE_ID=
STRIPE_CUSTOM_CIVILIAN_MONTHLY_PRICE_ID=
STRIPE_CUSTOM_CIVILIAN_ANNUAL_PRICE_ID=
STRIPE_PERFORMANCE_CIVILIAN_MONTHLY_PRICE_ID=
STRIPE_PERFORMANCE_CIVILIAN_ANNUAL_PRICE_ID=
STRIPE_ELITE_CIVILIAN_MONTHLY_PRICE_ID=
STRIPE_ELITE_CIVILIAN_ANNUAL_PRICE_ID=
# MILITARY tiers:
STRIPE_FOUNDATION_MILITARY_MONTHLY_PRICE_ID=
STRIPE_FOUNDATION_MILITARY_ANNUAL_PRICE_ID=
STRIPE_CUSTOM_MILITARY_MONTHLY_PRICE_ID=
STRIPE_CUSTOM_MILITARY_ANNUAL_PRICE_ID=
STRIPE_PERFORMANCE_MILITARY_MONTHLY_PRICE_ID=
STRIPE_PERFORMANCE_MILITARY_ANNUAL_PRICE_ID=
STRIPE_ELITE_MILITARY_MONTHLY_PRICE_ID=
STRIPE_ELITE_MILITARY_ANNUAL_PRICE_ID=
# Coupons: Stripe Dashboard → Products → Coupons.
STRIPE_MILITARY_COUPON_ID=
STRIPE_NEWBIE_COUPON_ID=

# -----------------------------------------------------------------------------
# EXERCISE DATA — RapidAPI (ExerciseDB)
# -----------------------------------------------------------------------------
# RapidAPI Dashboard → your app → subscribed API → "X-RapidAPI-Key".
RAPIDAPI_KEY=

# -----------------------------------------------------------------------------
# WEARABLES — Terra API
# -----------------------------------------------------------------------------
# Terra Dashboard → Connections / API keys.
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# NUTRITION — Nutritionix
# -----------------------------------------------------------------------------
# Nutritionix Developer Dashboard → your app → App ID + App Key.
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# -----------------------------------------------------------------------------
# YOUTUBE — Data API (unlisted training videos)
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → API key
# (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
# Public base URL of the app (used in emails, links, redirects).
NEXT_PUBLIC_APP_URL=
# Public display name of the app.
NEXT_PUBLIC_APP_NAME=Star Haven

# -----------------------------------------------------------------------------
# SECRETS — internal endpoints
# -----------------------------------------------------------------------------
# CRON_SECRET: random string; Vercel Cron sends it as a Bearer token to protect
#   /api/cron/* routes. Generate with `openssl rand -hex 32`.
# ADMIN_SECRET: random string guarding one-off admin/maintenance endpoints.
CRON_SECRET=
ADMIN_SECRET=
